<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Execution_of_Darkness_Wikia.SiteMaster" %>
<!DOCTYPE html>
<html lang="pt-br">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Execution of Darkness Wikia</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/Content/eod-wiki.css" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-dark eod-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold" runat="server" href="~/">Execution of Darkness Wikia</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">Início</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Articles/ArticleList.aspx">Artigos</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Characters/CharacterList.aspx">Personagens</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Factions/FactionList.aspx">Facções</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Locations/LocationList.aspx">Locais</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Timeline/TimelineList.aspx">Linha do Tempo</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Help.aspx">Ajuda</a></li>
                        <li class="nav-item" id="liSchemaCompare" runat="server"><a class="nav-link text-warning" runat="server" href="~/Pages/Admin/SchemaCompare.aspx">Schema Compare</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <asp:LoginView runat="server" ViewStateMode="Disabled">
                            <AnonymousTemplate>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/Account/Login.aspx">Login</a></li>
                                <li class="nav-item"><a class="nav-link" runat="server" href="~/Account/Register.aspx">Registrar</a></li>
                            </AnonymousTemplate>
                            <LoggedInTemplate>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <asp:LoginName runat="server" CssClass="d-inline" />
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="userDropdown">
                                        <li><a class="dropdown-item" runat="server" href="~/Account/Manage.aspx">Minha Conta</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><asp:LoginStatus runat="server" LogoutAction="Redirect" LogoutText="Logout" LogoutPageUrl="~/" CssClass="dropdown-item" /></li>
                                    </ul>
                                </li>
                            </LoggedInTemplate>
                        </asp:LoginView>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container eod-shell">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            <footer style="margin-top:3rem; padding-top:1.5rem; border-top:1px solid rgba(255,255,255,.06);">
                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:2rem; margin-bottom:1.5rem;">
                    <div>
                        <h4 style="font-size:.9rem; font-weight:800; margin-bottom:.5rem; color:var(--eod-accent-2);">Navegação</h4>
                        <ul style="list-style:none; padding:0; margin:0; font-size:.88rem; line-height:2;">
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/">Início</a></li>
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Pages/Articles/ArticleList.aspx">Artigos</a></li>
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Pages/Characters/CharacterList.aspx">Personagens</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 style="font-size:.9rem; font-weight:800; margin-bottom:.5rem; color:var(--eod-accent-2);">Universo</h4>
                        <ul style="list-style:none; padding:0; margin:0; font-size:.88rem; line-height:2;">
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Pages/Factions/FactionList.aspx">Facções</a></li>
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Pages/Locations/LocationList.aspx">Locais</a></li>
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Pages/Timeline/TimelineList.aspx">Linha do Tempo</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 style="font-size:.9rem; font-weight:800; margin-bottom:.5rem; color:var(--eod-accent-2);">Ferramentas</h4>
                        <ul style="list-style:none; padding:0; margin:0; font-size:.88rem; line-height:2;">
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Help.aspx">Ajuda</a></li>
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Pages/Admin/SchemaCompare.aspx">Schema Compare</a></li>
                            <li><a style="color:var(--eod-muted); text-decoration:none;" href="/Contact.aspx">Contato</a></li>
                        </ul>
                    </div>
                </div>
                <div class="eod-footer-note" style="text-align:center; padding-bottom:1rem;">
                    Execution of Darkness Wikia — Base de conhecimento do universo de dark fantasy. Personagens, facções, locais, cronologia e lore.
                </div>
            </footer>
        </div>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
